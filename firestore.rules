rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsBudget(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validBudget() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion','revision','data','updatedAt'])
        && d.keys().hasOnly(['schemaVersion','revision','data','updatedAt'])
        && d.schemaVersion == 1 && d.revision is int && d.revision > 0
        && d.data is string && d.data.size() <= 700000
        && d.updatedAt == request.time;
    }
    match /budgets/{uid} {
      allow get: if ownsBudget(uid);
      allow list: if false;
      allow create: if ownsBudget(uid) && validBudget() && request.resource.data.revision == 1;
      allow update: if ownsBudget(uid) && validBudget()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
